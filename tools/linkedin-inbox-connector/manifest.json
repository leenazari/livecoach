{
  "manifest_version": 3,
  "name": "LiveCoach LinkedIn Inbox",
  "description": "User-triggered, inbound-only LinkedIn message capture for LiveCoach CRM.",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.livecoachcrm.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/messaging/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sync LinkedIn messages to LiveCoach"
  }
}
