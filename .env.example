# OpenAI model router
OPENAI_API_KEY=
OPENAI_MODEL_LIVE=gpt-5.6-luna
OPENAI_MODEL_PRO=gpt-5.6-terra
OPENAI_MODEL_THINK=gpt-5.6-sol
OPENAI_MODEL_BRAIN=gpt-5.6-sol

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public links placed in invitation and digest emails
NEXT_PUBLIC_APP_URL=https://www.livecoachcrm.com

# Live audio and transcription
DEEPGRAM_API_KEY=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Calendar and Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.livecoachcrm.com/api/auth/google/callback

# Optional Microsoft Outlook and Calendar OAuth
# Register a Microsoft Entra web app that accepts personal and work accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://www.livecoachcrm.com/api/auth/microsoft/callback

# Optional per-user LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://www.livecoachcrm.com/api/auth/linkedin/callback

# Existing Google Meet listener (unchanged in this migration)
RECALL_API_KEY=
RECALL_REGION=
MEET_WORKER_URL=

# Optional integrations
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=
ELEVENLABS_VOICE_ID=
# Outreach defaults to the stable multilingual model. The global voice is used
# only by the workspace owner. Other salespeople must save their own voice ID.
ELEVENLABS_OUTREACH_MODEL_ID=eleven_multilingual_v2
# Optional accounting rate. When omitted, characters are still logged but the
# dashboard does not invent a cost for the external ElevenLabs plan.
ELEVENLABS_COST_GBP_PER_1000_CHARS=
SUPADATA_API_KEY=
VOYAGE_API_KEY=
CRON_SECRET=
